<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permiso de INTERNET: la app se conecta al API del drive (192.168.x.x / DDNS). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Permite que la app dispare la instalación de un .apk descargado
         (actualizador interno: descarga el update y abre el instalador). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Avisos de eventos (falta 1 semana / falta 1 día). Android 13+ exige
         que el usuario conceda este permiso: la app lo pide al iniciar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Avisos con la app CERRADA (eventos y paquete): una alarma despierta
         al receptor cada minuto. Al reiniciar el teléfono hay que volver a
         pedirla, de ahí este permiso. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Descargas del Drive (Android 9 y anteriores): escribir en la carpeta
         pública de Descargas. En Android 10+ se usa MediaStore y este permiso
         NO se declara (maxSdkVersion lo limita a los sistemas que lo exigen). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- HTTP plano: el servidor usa http:// (sin TLS). Quitar al pasar a HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Hardstreet Platform"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Widget de inicio "Próximos eventos": la app le empuja los eventos
             por el canal hardstreet/events_widget. -->
        <receiver
            android:name=".EventWidgetProvider"
            android:exported="false"
            android:label="@string/event_widget_header">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/event_widget_info" />
        </receiver>
        <!-- Avisos con la app cerrada: consulta `/api/reminders` (eventos,
             canal `reminders`) y `/api/my/notifications` (paquete, canal
             `paquete`) y publica una notificación por cada aviso nuevo. -->
        <receiver
            android:name=".PackageNotificationsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <!-- Al actualizar la app se borran las alarmas: se reponen. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <!-- Lista del widget: RemoteViewsService que llena el listado de
             eventos (así se ven TODOS y el widget se puede desplazar). Solo el
             sistema (la appwidget host) puede enlazarlo: BIND_REMOTEVIEWS. -->
        <service
            android:name=".EventWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- FileProvider para entregar el .apk descargado al instalador
             del sistema como content:// (Android 7+ prohíbe file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
