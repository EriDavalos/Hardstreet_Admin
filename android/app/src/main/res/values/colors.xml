<?xml version="1.0" encoding="utf-8"?>
<!-- Paleta del widget "Próximos eventos".

     IMPORTANTE: NO hay carpeta values-night. El widget NO sigue el modo del
     sistema, sigue el modo de la APP (que se lo empuja por el canal
     hardstreet/events_widget). Por eso el claro y el oscuro son colores con
     NOMBRES DISTINTOS (…_dark) y el provider elige uno u otro en tiempo de
     ejecución; así el tema del teléfono no pisa la elección del usuario.

     Los TEXTOS y la marca son EXACTAMENTE los de AppTheme (lib/theme.dart):
     onSurface / onSurfaceVariant, el acento es el primary y las líneas son
     dividerColor. El FONDO es la única excepción a propósito: un poco más
     oscuro que la cardColor del tema, para que el widget se distinga del fondo
     de pantalla (y sin borde: el trazo se recortaba en las esquinas).
     La prueba test/event_widget_theme_test.dart compara esto con el tema real
     de la app: si alguien cambia la paleta, el test lo avisa. -->
<resources>

    <!-- Tarjeta: un poco MÁS OSCURA que la cardColor del tema para que el
         widget se distinga del fondo de pantalla (y sin borde: el trazo se
         recortaba en las esquinas redondeadas). -->
    <color name="event_widget_bg">#F3F6FC</color>
    <color name="event_widget_bg_dark">#0D121C</color>

    <!-- Acento de la marca (encabezado y rótulo de día): el MISMO primary del
         tema, también en oscuro (la app no aclara su azul en modo oscuro). -->
    <color name="event_widget_accent">#2F6BFF</color>
    <color name="event_widget_accent_dark">#2F6BFF</color>

    <!-- Textos (onSurface y onSurfaceVariant del tema) -->
    <color name="event_widget_title">#1A1B21</color>
    <color name="event_widget_title_dark">#E3E1E9</color>
    <color name="event_widget_muted">#45464F</color>
    <color name="event_widget_muted_dark">#C6C6D0</color>
    <color name="event_widget_time">#2F6BFF</color>
    <color name="event_widget_time_dark">#2F6BFF</color>

    <!-- Líneas -->
    <color name="event_widget_divider">#E5EAF2</color>
    <color name="event_widget_divider_dark">#2C3443</color>

    <!-- Pastilla con el número de eventos y botón "Agregar agenda":
         la marca translúcida ya aplanada sobre la tarjeta (8 % en claro,
         16 % en oscuro). -->
    <color name="event_widget_badge">#EEF3FF</color>
    <color name="event_widget_badge_dark">#1D2E54</color>
    <color name="event_widget_add_bg">#EEF3FF</color>
    <color name="event_widget_add_bg_dark">#1D2E54</color>
</resources>
