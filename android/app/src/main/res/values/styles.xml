<?xml version="1.0" encoding="utf-8"?>
<!-- Tema aplicado mientras la app arranca (Modo claro del sistema).
     windowLightStatusBar: iconos de la barra de notificaciones OSCUROS
     (fondo blanco del splash) y ventana CLARA: así la barra NUNCA se ve
     negra durante el arranque. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Tema aplicado en cuanto el proceso arranca (detrás de Flutter).
         El fondo blanco evita la pantalla/barra negra hasta el primer frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
