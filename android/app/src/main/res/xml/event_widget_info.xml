<?xml version="1.0" encoding="utf-8"?>
<!-- Metadatos del widget "Próximos eventos".

     updatePeriodMillis = 0: el widget NO consulta nada por su cuenta; la app
     le EMPUJA los eventos (que es quien tiene la sesión y los datos).

     El widget muestra TODA la agenda próxima en una lista desplazable, así que
     pide un tamaño mínimo cómodo (~4 filas) y se puede redimensionar. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/event_widget_description"
    android:initialLayout="@layout/event_widget"
    android:minHeight="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/event_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
