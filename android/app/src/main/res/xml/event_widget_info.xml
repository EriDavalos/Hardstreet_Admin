<?xml version="1.0" encoding="utf-8"?>
<!-- Metadatos del widget "Próximos eventos".

     updatePeriodMillis = 30 min: el widget NO consulta nada por su cuenta (la
     app le EMPUJA los eventos, que es quien tiene la sesión y los datos), pero
     SÍ se repinta solo de vez en cuando para que el rótulo del día ("HOY ·
     16 OCT") y el descarte de lo que ya pasó sigan siendo ciertos aunque la
     app esté cerrada. El sistema no admite periodos menores a 30 minutos;
     para el refresco fino el widget usa además su propia alarma (ver
     EventWidgetProvider.scheduleRefresh, cada 15 min).

     El widget muestra TODA la agenda próxima en una lista desplazable, así que
     pide un tamaño mínimo cómodo (~4 filas) y se puede redimensionar. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/event_widget_description"
    android:initialLayout="@layout/event_widget"
    android:minHeight="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/event_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
