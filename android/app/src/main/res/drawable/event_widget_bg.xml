<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de eventos (modo CLARO): el MISMO lenguaje visual que la
     app, tarjeta plana con borde suave y esquinas redondeadas. El modo OSCURO
     es event_widget_bg_dark.xml y lo elige el provider según el modo de la app
     (el widget no sigue el tema del sistema). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/event_widget_bg" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/event_widget_border" />
</shape>
