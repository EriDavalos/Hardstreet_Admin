<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de eventos (modo CLARO): tarjeta plana con esquinas
     redondeadas y SIN borde dibujado (el trazo de 1dp se recortaba en las
     curvas y se veía sucio). El modo OSCURO es event_widget_bg_dark.xml y lo
     elige el provider según el modo de la app (no el del sistema). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/event_widget_bg" />
    <corners android:radius="20dp" />
</shape>
