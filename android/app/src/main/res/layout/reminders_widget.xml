<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de inicio «Avisos».

     Misma estructura que el widget «Próximos eventos» (event_widget.xml):
     tarjeta plana, encabezado con acento de la marca, contador de avisos y
     debajo el listado de avisos recientes (RemoteViewsService:
     RemindersWidgetService). SIN botón «+»: los avisos no se crean aquí.

     REUTILIZA los colores, fondos y pastilla del widget de eventos (ver
     res/values/colors.xml) y también el layout de fila event_widget_row.xml;
     los colores los ajusta HsWidgetTheme/EventWidgetTheme en tiempo de
     ejecución según el MODO DE LA APP (claro/oscuro), no el del sistema.

     Toques: fila o tarjeta traen la app al frente (los PendingIntent los
     arma RemindersWidgetProvider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminders_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/event_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/reminders_widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/reminders_widget_header"
            android:textColor="@color/event_widget_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminders_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/event_widget_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/event_widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/reminders_widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/event_widget_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/reminders_widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/reminders_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/reminders_widget_empty"
            android:textColor="@color/event_widget_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
