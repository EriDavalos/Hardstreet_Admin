<?xml version="1.0" encoding="utf-8"?>
<!-- Tema aplicado mientras la app arranca (Modo oscuro del sistema). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Tema detrás de Flutter. El fondo es el MISMO azul-negro del arranque de
         la app (#0C111C): en oscuro ya no hay destello blanco antes del primer
         frame, la animación de inicio nace sin costuras. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#0C111C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
